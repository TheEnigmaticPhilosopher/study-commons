# Copy to .env locally, or add these names in Replit Secrets.
# The server loads .env automatically. Never commit it or paste credentials in chat.
PORT=3000
APP_ORIGIN=http://localhost:3000
# Choose a unique password of at least 16 characters (not your Canvas token).
HUB_ADMIN_PASSWORD=
# demo uses fictional data; live discovers your available and completed courses.
CANVAS_MODE=demo
CANVAS_BASE_URL=https://your-school.instructure.com
# Optional: only needed for the older single-course library mapping screen.
CANVAS_COURSE_ID=
CANVAS_ACCESS_TOKEN=
DATABASE_PATH=./data/study-commons.sqlite
